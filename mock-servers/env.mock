# Exemplo .env para usar com Mock Servers
# Copie este arquivo para .env e ajuste conforme necessário

# ========================================
# MOCK SERVERS (Sem tokens necessários)
# ========================================

# Jira Mock (requer Node.js rodando)
JIRA_HOST=http://localhost:8001
JIRA_EMAIL=demo@squad.local
JIRA_API_TOKEN=mock-token-local-demo
JIRA_PROJECT_KEY=SQUAD

# Confluence Mock (requer Node.js rodando)
CONFLUENCE_HOST=http://localhost:8002/wiki
CONFLUENCE_EMAIL=demo@squad.local
CONFLUENCE_API_TOKEN=mock-token-local-demo
CONFLUENCE_SPACE_KEY=SQUAD

# ========================================
# GitHub (REQUERIDO - com token real)
# ========================================

# Gerar em: https://github.com/settings/tokens
# Escopos: repo, workflow, admin:repo_hook
GITHUB_TOKEN=github_pat_YOUR_TOKEN_HERE
GITHUB_OWNER=fabiopolli
GITHUB_REPO=squad-training-hub

# ========================================
# GCP (Opcional)
# ========================================

# Gerar service account em GCP Console
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-key.json
# GCP_PROJECT_ID=seu-projeto-gcp

# ========================================
# COMO USAR ESTE ARQUIVO
# ========================================

# 1. Inicie os mock servers:
#    ./start-mocks.sh (Linux/Mac)
#    .\start-mocks.ps1 (Windows)
#
# 2. Copie este arquivo para .env:
#    cp .env.mock .env
#
# 3. Substitua GITHUB_TOKEN por um real
#
# 4. Use no seu .env local:
#    source .env
#
# 5. Agora você pode testar!
